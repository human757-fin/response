# Discord
DISCORD_TOKEN=replace-with-your-bot-token
DEV_GUILD_ID=

# Service ports
BOT_PORT=2067
WEB_PORT=2040

# Web panel (set a strong password in production)
WEBUI_PASSWORD=replace-with-a-long-random-password
WEBUI_SECURE_COOKIE=0

# MySQL/MariaDB production database (uncomment on Pterodactyl)
# DATABASE_ENGINE=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=response
# DB_USER=response
# DB_PASSWORD=replace-with-the-pterodactyl-database-password
# DB_SSL=0

# SQLite fallback (used only when DB_HOST and DATABASE_URL are empty)
DATABASE_PATH=response.db
LOG_LEVEL=INFO
